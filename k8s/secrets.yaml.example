# ScaleMesh Kubernetes Secrets Template
# Instructions: Copy this file to k8s/secrets.yaml and replace placeholder values before deployment:
#   Windows: copy k8s\secrets.yaml.example k8s\secrets.yaml
#   Linux/macOS: cp k8s/secrets.yaml.example k8s/secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: scalemesh-secrets
  namespace: scalemesh
type: Opaque
stringData:
  DB_USER: "root"
  DB_PASSWORD: "CHANGE_ME_LOCAL_PASSWORD"
  GRAFANA_ADMIN_USER: "admin"
  GRAFANA_ADMIN_PASSWORD: "CHANGE_ME_LOCAL_PASSWORD"
